<Window x:Class="PlugHub.ClearHeightAnalysis.UI.V2AnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="净高分析 V2" Width="700" Height="720"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei" FontSize="13"
        Background="#F5F5F5">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="净高分析" FontSize="20" FontWeight="SemiBold" Foreground="#2B579A"/>
            <TextBlock Text="选择真实楼层、分析范围和参与模型。计算结果将独立保存，可按需生成不同成果。"
                       Margin="0,6,0,16" Foreground="#666" TextWrapping="Wrap"/>

            <GroupBox Header="分析上下文" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="楼层" VerticalAlignment="Center"/>
                    <ComboBox x:Name="LevelComboBox" Grid.Column="1" DisplayMemberPath="DisplayName" Padding="6"/>
                    <TextBlock Grid.Row="1" Text="分析范围" Margin="0,12,0,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="BoundaryModeComboBox" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Padding="6"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="参与模型" Padding="12" Margin="0,0,0,12">
                <ItemsControl x:Name="SourceModelsItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}"
                                      IsEnabled="{Binding IsLoaded}" Margin="0,3"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>

            <GroupBox Header="计算参数" Padding="12" Margin="0,0,0,12">
                <UniformGrid Columns="4" Rows="3">
                    <TextBlock Text="网格尺寸 mm" VerticalAlignment="Center"/>
                    <TextBox x:Name="GridSizeTextBox" Text="1000" Padding="6" Margin="4"/>
                    <TextBlock Text="净高阈值 mm" VerticalAlignment="Center"/>
                    <TextBox x:Name="ThresholdTextBox" Text="3000" Padding="6" Margin="4"/>
                    <TextBlock Text="完成面偏移 mm" VerticalAlignment="Center"/>
                    <TextBox x:Name="FinishOffsetTextBox" Text="0" Padding="6" Margin="4"/>
                    <TextBlock Text="搜索高度 mm" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchHeightTextBox" Text="6000" Padding="6" Margin="4"/>
                    <TextBlock Text="最小管径 mm" VerticalAlignment="Center"/>
                    <TextBox x:Name="MinimumPipeTextBox" Text="50" Padding="6" Margin="4"/>
                </UniformGrid>
            </GroupBox>

            <WrapPanel Margin="0,0,0,8">
                <CheckBox x:Name="IncludeCeilingsCheckBox" Content="包含吊顶" IsChecked="True" Margin="0,0,24,0"/>
                <CheckBox x:Name="IncludeMepCheckBox" Content="包含机电" IsChecked="True"/>
            </WrapPanel>
            <TextBlock x:Name="ValidationText" Foreground="#A33" TextWrapping="Wrap" Margin="0,4,0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Padding="20,8" Margin="0,0,10,0" Click="CancelButton_Click"/>
                <Button Content="开始分析" Padding="20,8" Background="#2B579A" Foreground="White"
                        BorderThickness="0" Click="AnalyzeButton_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
